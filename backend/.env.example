# ── MongoDB ───────────────────────────────────────────────────────────────────
# Required. Example: mongodb+srv://<user>:<password>@<cluster>/<database>
MONGO_URI=

# ── Session ───────────────────────────────────────────────────────────────────
# Required in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Redis (optional) ──────────────────────────────────────────────────────────
# When omitted, sessions fall back to the in-memory store (development only).
# REDIS_URL=redis://127.0.0.1:6379

# ── ConvertAPI (required for Word <-> PDF conversions) ────────────────────────
# Create a free account at https://www.convertapi.com/ and copy the secret key.
# Never hardcode this value in source code.
CONVERTAPI_SECRET=

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3000
# Frontend origin allowed by CORS. Set this to your Vercel URL in production.
FRONTEND_URL=https://convertify-vvl8.vercel.app

# ── Limits (optional) ─────────────────────────────────────────────────────────
# MAX_UPLOAD_SIZE_MB=20
# MAX_MERGE_FILES=10
# CONVERTAPI_TIMEOUT_SECONDS=120
# CONVERTIFY_TEMP_DIR=
